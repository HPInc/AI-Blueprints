   "source": [
    "# Translate the Text"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Translated Text:\n",
      "mi mamá siempre decía que la vida como una caja de chocolates nunca sabe lo que vas a conseguir\n",
      "\n"
     ]
    }
   ],
   "source": [
    "# ------------------------- Step 2: Neural Machine Translation (NMT) -------------------------\n",
    "\n",
    "# Move the NMT model to GPU\n",
    "mt_model = mt_model.to(device)\n",
    "\n",
    "# Tokenize the transcribed text\n",
    "inputs = tokenizer(transcribed_text, return_tensors=\"pt\", padding=True)\n",
    "\n",
    "# Move inputs to the same device as the model\n",
    "inputs = {key: value.to(device) for key, value in inputs.items()}\n",
    "\n",
    "# Generate the translation\n",
    "translated = mt_model.generate(**inputs)\n",
    "\n",
    "# Decode the translated tokens into text\n",
    "translated_text = tokenizer.decode(translated[0], skip_special_tokens=True)\n",
    "\n",
    "# Print the translated text\n",
    "print(f\"Translated Text:\\n{translated_text}\\n\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Convert Text to Audio"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ------------------------- Step 3: Text-to-Speech (TTS) -------------------------\n",
    "\n",
    "# Move the Spectrogram Generator and Vocoder models to GPU\n",
    "spectrogram_generator = spectrogram_generator.to(device)\n",
    "vocoder = vocoder.to(device)\n",
    "\n",
    "# Parse the translated text into tokens for spectrogram generation\n",
    "tokens = spectrogram_generator.parse(translated_text)\n",
    "\n",
    "# Generate a mel-spectrogram for the parsed tokens (speaker ID 2 used here)\n",
    "spectrogram = spectrogram_generator.generate_spectrogram(tokens=tokens, speaker=2)\n",
    "\n",
    "# Convert the generated spectrogram into audio waveform using the vocoder\n",
    "audio_tensor = vocoder.convert_spectrogram_to_audio(spec=spectrogram)"
   ]
  },
